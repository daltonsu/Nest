{
  "name": "agent-autoloop",
  "description": "Let Agents follow up on work and ask when they need your judgment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKKKhazix/agent-autoloop.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-autoloop": "bin/agent-autoloop.ts"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:backend": "node --disable-warning=ExperimentalWarning bin/agent-autoloop.ts up",
    "start:frontend": "npm --prefix frontend start",
    "service:install": "node --disable-warning=ExperimentalWarning bin/agent-autoloop.ts service install && npm --prefix frontend run service:install",
    "service:stop": "npm --prefix frontend run service:remove && node --disable-warning=ExperimentalWarning bin/agent-autoloop.ts service remove",
    "service:status": "node --disable-warning=ExperimentalWarning bin/agent-autoloop.ts status && npm --prefix frontend run service:status",
    "check:frontend": "node --check scripts/start.mjs && npm --prefix frontend run check",
    "test:frontend": "npm --prefix frontend test",
    "test:integration": "npm --prefix frontend run test:integration",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts && npm run test:frontend",
    "test:quick": "node --disable-warning=ExperimentalWarning --test \"tests/!(simulation).test.ts\" && npm run test:frontend",
    "typecheck": "tsc -p .",
    "format": "prettier --write \"**/*.{ts,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml}\"",
    "test:sim": "node --disable-warning=ExperimentalWarning sim/random.ts 24301 20000",
    "test:deep": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 sim/*.test.ts",
    "test:nightly": "npm run test:deep && node --disable-warning=ExperimentalWarning scripts/benchmark.ts",
    "benchmark": "node --disable-warning=ExperimentalWarning scripts/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 120
  }
}
